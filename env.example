BOT_TOKEN=123456:ABC-your-bot-token
OWNER_ID=123456789
# Optional: ID from the Drive folder URL (drive.google.com/drive/folders/<ID>)
DRIVE_FOLDER_ID=

# Optional: upload to your website admin page instead of Google Drive
# SITE_URL=https://audiosfm.online/r2admin.php
# SITE_PIN=your-admin-pin

# --- Speed tuning (optional) ---
# Files downloaded/compressed at the same time (match your vCPU count)
PARALLEL_FILES=2
# Parts of one website upload sent in parallel (4-8)
SITE_PARALLEL=6
# Retries of a single failed part
PART_RETRIES=3
# ffmpeg mp3 speed: 0 best/slowest ... 9 fastest (7 default)
MP3_LEVEL=7

# Large files (up to 2 GB): set automatically by bigfiles.sh
# LOCAL_API_URL=http://localhost:8081
